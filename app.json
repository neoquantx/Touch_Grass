{
  "expo": {
    "name": "Touch Grass",
    "slug": "touch-grass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "touchgrass",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.touchgrass.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F6F4A",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Grasslock to use your location for missions.",
          "locationWhenInUsePermission": "Allow Touch Grass to use your location for missions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs photo access for missions.",
          "cameraPermission": "The app needs camera access for missions."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ]
    ]
  }
}
